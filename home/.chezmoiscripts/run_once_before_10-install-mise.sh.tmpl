#!/bin/sh
# Bootstrap the mise binary (https://mise.jdx.dev). Idempotent: no-op if present.
# The mise installer ships a static binary that runs on glibc AND musl (Alpine).
set -eu

log()  { printf '\033[1;34m::\033[0m %s\n' "$1"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$1" >&2; }

if command -v mise >/dev/null 2>&1 || [ -x "$HOME/.local/bin/mise" ]; then
    log "mise already present — skipping bootstrap."
    exit 0
fi

log "Installing mise into ~/.local/bin ..."
if   command -v curl >/dev/null 2>&1; then curl -fsSL https://mise.run | sh
elif command -v wget >/dev/null 2>&1; then wget -qO- https://mise.run | sh
else warn "Need curl or wget to install mise."; exit 1
fi

log "mise installed. ~/.zshrc activates it; ~/.zprofile wires shims for non-interactive shells."
