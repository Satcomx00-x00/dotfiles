#!/bin/sh
# Make zsh the default login shell. Idempotent and NON-fatal on locked-down hosts
# (containers, LDAP/PAM, missing chsh) so it never aborts `chezmoi apply`.
set -eu

log()  { printf '\033[1;34m::\033[0m %s\n' "$1"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$1" >&2; }

ZSH_BIN="$(command -v zsh 2>/dev/null || true)"
[ -z "$ZSH_BIN" ] && { warn "zsh not installed — skipping default-shell change."; exit 0; }

case "${SHELL:-}" in
    */zsh) log "zsh is already the default shell."; exit 0 ;;
esac

# Ensure zsh is an allowed login shell.
if ! grep -qxF "$ZSH_BIN" /etc/shells 2>/dev/null; then
    if [ "$(id -u)" -eq 0 ]; then
        echo "$ZSH_BIN" >> /etc/shells 2>/dev/null || true
    elif command -v sudo >/dev/null 2>&1; then
        echo "$ZSH_BIN" | sudo tee -a /etc/shells >/dev/null 2>&1 || true
    fi
fi

if command -v chsh >/dev/null 2>&1 && chsh -s "$ZSH_BIN" >/dev/null 2>&1; then
    log "Default shell set to zsh — log out/in to take effect."
else
    warn "Could not change shell automatically. Run:  chsh -s $ZSH_BIN"
fi
