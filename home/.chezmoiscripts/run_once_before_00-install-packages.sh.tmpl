#!/bin/sh
# Install BASE OS packages before dotfiles are applied.
# POSIX sh only — Alpine's /bin/sh is BusyBox ash (no bash, no [[ ]], no arrays).
# Modern CLIs come from mise, not from here. Package lists live in .chezmoidata.toml.
set -eu

log()  { printf '\033[1;34m::\033[0m %s\n' "$1"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$1" >&2; }

# --- privilege escalation (works as root, with sudo, or fails loudly) ---
if   [ "$(id -u)" -eq 0 ];               then SUDO=""
elif command -v sudo >/dev/null 2>&1;    then SUDO="sudo"
else warn "Need root or sudo to install packages — skipping base install."; exit 0
fi

# --- package-manager dispatch by binary presence (most robust across derivatives) ---
if   command -v apt-get >/dev/null 2>&1; then PM=apt
elif command -v apk     >/dev/null 2>&1; then PM=apk
elif command -v dnf     >/dev/null 2>&1; then PM=dnf
elif command -v yum     >/dev/null 2>&1; then PM=yum
else warn "No supported package manager (apt/apk/dnf/yum). Install zsh git curl manually."; exit 0
fi

log "Installing base packages with: $PM"
case "$PM" in
    apt)
        export DEBIAN_FRONTEND=noninteractive
        $SUDO apt-get update -qq
        $SUDO apt-get install -y --no-install-recommends {{ .packages.base.apt | join " " }}
        ;;
    apk)
        $SUDO apk add --no-cache {{ .packages.base.apk | join " " }}
        ;;
    dnf)
        $SUDO dnf install -y {{ .packages.base.dnf | join " " }}
        ;;
    yum)
        $SUDO yum install -y {{ .packages.base.dnf | join " " }}
        ;;
esac

log "Base packages installed."
