{{- if not .headless -}}
#!/bin/sh
# Rebuild the font cache after chezmoi downloads MesloLGS NF.
# Re-runs only when the external font set changes.
# fonts hash: {{ include ".chezmoiexternal.toml.tmpl" | sha256sum }}
set -eu
if command -v fc-cache >/dev/null 2>&1; then
    fc-cache -f "${XDG_DATA_HOME:-$HOME/.local/share}/fonts" >/dev/null 2>&1 || true
    printf '\033[1;34m::\033[0m %s\n' "Font cache rebuilt. Set 'MesloLGS NF' in your terminal for glyphs."
fi
{{- end -}}
