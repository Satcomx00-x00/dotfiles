#!/bin/sh
# Install/upgrade every tool declared in ~/.config/mise/config.toml.
# run_onchange_ + the hash below => this re-runs ONLY when the mise config changes.
# mise config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}
set -eu

log()  { printf '\033[1;34m::\033[0m %s\n' "$1"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$1" >&2; }

# locate the mise binary (PATH may not yet include ~/.local/bin during apply)
MISE=""
for c in mise "$HOME/.local/bin/mise"; do
    if command -v "$c" >/dev/null 2>&1; then MISE="$c"; break; fi
    [ -x "$c" ] && { MISE="$c"; break; }
done
[ -z "$MISE" ] && { warn "mise not found — skipping tool install."; exit 0; }

# CI / minimal images can skip the (large) tool downloads but still validate config.
if [ "${DOTFILES_SKIP_MISE_TOOLS:-0}" = "1" ]; then
    log "DOTFILES_SKIP_MISE_TOOLS=1 — validating config, skipping downloads."
    "$MISE" trust --yes "$HOME/.config/mise/config.toml" >/dev/null 2>&1 || true
    exit 0
fi

# Alpine/musl: use precompiled python-build-standalone (don't compile from source).
[ -r /etc/os-release ] && . /etc/os-release
if [ "${ID:-}" = "alpine" ]; then
    export MISE_PYTHON_COMPILE=0
    log "Alpine detected — MISE_PYTHON_COMPILE=0 (precompiled musl builds)."
fi

log "Installing mise-managed tools (first run can take a few minutes)…"
"$MISE" trust --yes "$HOME/.config/mise/config.toml" >/dev/null 2>&1 || true
"$MISE" install
"$MISE" reshim 2>/dev/null || true
log "mise tools ready: $("$MISE" ls --installed 2>/dev/null | wc -l | tr -d ' ') versions installed."
