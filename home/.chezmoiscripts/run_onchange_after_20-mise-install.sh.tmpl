#!/bin/sh
# Phase 4 — install every tool in the selected tier.
#
# run_onchange, keyed on the hash below: this is the longest phase in the
# bootstrap (hundreds of megabytes on `full`), and it must not run on an apply
# that only changed an alias. chezmoi re-runs it exactly when the inputs change.
#
# tools.toml:  {{ include ".chezmoidata/tools.toml" | sha256sum }}
# tier:        {{ .tier }}
#
# OPTIONAL phase in the sense that a failure warns rather than aborting: a
# machine with a working shell and three missing tools is far more useful than
# a machine whose apply died halfway through writing its config.

set -eu

log() { printf '  tools: %s\n' "$*"; }

export PATH="${XDG_BIN_HOME:-$HOME/.local/bin}:$PATH"

command -v mise > /dev/null 2>&1 || {
    log 'WARN mise not found — skipping tool installation'
    exit 0
}

# Escape hatch for CI and the sandbox: proves the whole flow without paying for
# the downloads, which prove nothing about the templates.
if [ "${DOTFILES_SKIP_MISE_TOOLS:-0}" = "1" ]; then
    log 'skipped (DOTFILES_SKIP_MISE_TOOLS=1)'
    exit 0
fi

log 'installing tier {{ .tier }} — this is the slow one'

# --yes: the config was generated by chezmoi seconds ago, so there is nobody to
# ask. Failures are reported per tool by mise itself.
if mise install --yes; then
    log 'all tools installed'
else
    log 'WARN some tools failed to install — run `mise install` to see which'
fi

# Shims must exist for cron, systemd units and IDEs, which never source a shell
# rc and therefore never run `mise activate`.
mise reshim > /dev/null 2>&1 || true

# ─── Invalidate the shell init cache ─────────────────────────────────────────
# interactive.sh caches the generated init snippets for starship, zoxide, fzf,
# direnv and mise, and rebuilds only when the SET of installed tools changes.
# A version bump does not change that set, so the cache is dropped here — the
# one moment where tool versions are known to have moved.
rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/init.zsh" \
    "${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/init.bash" 2> /dev/null || true

# ─── Staleness stamp (decision #34) ──────────────────────────────────────────
# interactive.sh reads this to decide whether to show the "N days since update"
# hint. Written here rather than on every apply so that editing one alias does
# not reset the clock.
_state="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
mkdir -p "$_state"
date +%s > "$_state/last-apply"
