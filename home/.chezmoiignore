{{/* Evaluated as a template: decide per-machine what NOT to apply. */}}

# Fonts only make sense where a terminal/GUI runs (glyphs render client-side).
{{- if .headless }}
.local/share/fonts
{{- end }}

# Work git identity is only applied when a work email was configured.
{{- if not .workEmail }}
.config/git/config-work
{{- end }}
