{{/*
  Evaluated as a template on every apply: decides, per machine, what NOT to
  materialise. Anything listed here is left untouched in the target directory.

  Every entry below tests a DERIVED flag from .chezmoi.toml.tmpl rather than
  re-deriving from .profile — see the note there. The exception is tierRank,
  which is itself a derived integer and is compared numerically so tiers stay
  cumulative (minimal ⊂ standard ⊂ full) without a chain of `or (eq ...)`.
*/}}

# ─── Fonts: only where a terminal emulator actually renders glyphs ───────────
{{- if not .fonts }}
.local/share/fonts
{{- end }}

# ─── Terminal emulators: GUI applications, config is inert without them ──────
{{- if not .terminals }}
.config/ghostty
.config/alacritty
{{- end }}

# ─── SSH commit signing allow-list: only when signing is on ──────────────────
{{- if not (and .gpgSign .signingKey) }}
.config/git/allowed_signers
{{- end }}

# ─── Secrets drop-in: only with a configured backend ─────────────────────────
# Without this guard the template would call `bw` on a machine that has neither
# the CLI nor a vault, and the entire apply would fail — not just this file.
{{- if eq .secretsBackend "none" }}
.config/shell/secrets.sh
{{- end }}

# ─── Backups: only where there is state worth keeping ────────────────────────
# A container is rebuilt from its image, so a snapshot of one captures nothing
# `docker build` would not. Also skipped below tier 1, which is where restic
# itself enters the inventory — config for a binary that is not installed is
# just a trap for `dotfiles doctor`.
{{- if or (not .backups) (lt .tierRank 1) }}
.config/restic
.config/systemd/user/dotfiles-backup.service
.config/systemd/user/dotfiles-backup.timer
{{- end }}

# ─── minimal tier: the vi-compatible fallback only, no editor, no multiplexer ─
{{- if lt .tierRank 1 }}
.config/nvim
.config/zellij
{{- end }}

# ─── full tier only ──────────────────────────────────────────────────────────
{{- if lt .tierRank 2 }}
.config/k9s
{{- end }}

# ─── Never managed, ever ─────────────────────────────────────────────────────
# Listed for the reader's benefit and as a guard against a future commit
# accidentally adding them to the source tree. Decision #30: these are the
# files that would turn a public repo into a map of your estate.
.config/shell/local.sh
.ssh/config.d
