# ~/.zshrc — managed by chezmoi (edit with `chezmoi edit ~/.zshrc`).
#
# Strict ordering, because zsh plugins wrap each other's widgets:
#   zellij autostart → p10k instant prompt → env → history/options → completion
#   → mise (before omz, so plugin completions find their tools)
#   → oh-my-zsh (+ plugins) → tool init → aliases → p10k config
#   → zsh-syntax-highlighting (MUST be the very last thing sourced).

# ---------------------------------------------------------------------------
# 0. Zellij auto-start (opt-in; nesting- and non-interactive-safe).
#    It either execs into Zellij (replacing this shell — no output here) or is a
#    no-op, so it is safe above the instant prompt. Default on, except servers.
# ---------------------------------------------------------------------------
: ${ZELLIJ_AUTOSTART:={{ if eq .machineType "server" }}false{{ else }}true{{ end }}}
if [[ -z "$ZELLIJ" && "$ZELLIJ_AUTOSTART" == "true" && -z "$ZELLIJ_SKIP" && $- == *i* ]] \
        && command -v zellij >/dev/null 2>&1; then
    if [[ "${ZELLIJ_AUTO_ATTACH:-true}" == "true" ]]; then
        zellij attach --create main
    else
        zellij
    fi
    [[ "${ZELLIJ_AUTO_EXIT:-true}" == "true" ]] && exit
fi

# ---------------------------------------------------------------------------
# 1. Powerlevel10k instant prompt. Keep near the top. Only code that needs
#    console INPUT may go above; anything that prints OUTPUT must go below.
# ---------------------------------------------------------------------------
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi
typeset -g POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true

# ---------------------------------------------------------------------------
# 2. Environment & PATH
# ---------------------------------------------------------------------------
export LANG="${LANG:-C.UTF-8}"   # safe default; always present (even minimal Alpine)
export EDITOR="{{ .editor }}"
export VISUAL="{{ .editor }}"
export PAGER="less"
export LESS="-R"
export GOPATH="$HOME/go"
export NODE_OPTIONS="--max-old-space-size=8192"

typeset -U path PATH   # keep PATH de-duplicated
path=(
    "$HOME/.local/bin"
    "$HOME/bin"
    "$HOME/.cargo/bin"
    "$GOPATH/bin"
    $path
)
export PATH

# ---------------------------------------------------------------------------
# 3. History
# ---------------------------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE
setopt HIST_FIND_NO_DUPS HIST_SAVE_NO_DUPS HIST_REDUCE_BLANKS HIST_VERIFY
setopt SHARE_HISTORY INC_APPEND_HISTORY EXTENDED_HISTORY

# ---------------------------------------------------------------------------
# 4. Options & keybindings
# ---------------------------------------------------------------------------
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT
setopt AUTO_LIST AUTO_MENU AUTO_PARAM_SLASH COMPLETE_IN_WORD
setopt EXTENDED_GLOB NO_BEEP INTERACTIVE_COMMENTS NUMERIC_GLOB_SORT
bindkey -e

# ---------------------------------------------------------------------------
# 5. Completion styling (also drives fzf-tab)
# ---------------------------------------------------------------------------
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' '+l:|=* r:|=*'
zstyle ':completion:*' menu no
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' group-name ''
zstyle ':fzf-tab:complete:cd:*' fzf-preview \
    'eza -1 --color=always --icons=auto "$realpath" 2>/dev/null || ls -1 "$realpath"'
zstyle ':fzf-tab:*' fzf-flags --height=60% --layout=reverse --border

# ---------------------------------------------------------------------------
# 6. mise — runtimes & CLI tools, BEFORE oh-my-zsh so plugin completions
#    (kubectl/helm/terraform/npm) find their binaries. stderr silenced to keep
#    the instant prompt clean.
# ---------------------------------------------------------------------------
if command -v mise >/dev/null 2>&1; then
    { emulate zsh -c "$(mise activate zsh)" } 2>/dev/null
elif [[ -x "$HOME/.local/bin/mise" ]]; then
    { emulate zsh -c "$("$HOME/.local/bin/mise" activate zsh)" } 2>/dev/null
fi

# ---------------------------------------------------------------------------
# 7. Oh My Zsh
# ---------------------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
zstyle ':omz:update' mode disabled          # updates handled by chezmoi externals
DISABLE_MAGIC_FUNCTIONS=true                 # faster & avoids paste bugs
ENABLE_CORRECTION=false
COMPLETION_WAITING_DOTS=true
# zsh-syntax-highlighting is intentionally absent here — it is sourced LAST (step 11).
plugins=(
    git
    sudo
    command-not-found
    colored-man-pages
    extract
    docker
    docker-compose
    kubectl
    helm
    terraform
    python
    pip
    npm
    zsh-completions
    fzf-tab
    zsh-autosuggestions
)
[[ -r "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# ---------------------------------------------------------------------------
# 8. Modern CLI tool initialisation (each guarded; works if a tool is missing)
# ---------------------------------------------------------------------------
# zoxide — smarter cd (keeps the `cd` command, adds frecency jumps)
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh --cmd cd)"

# fzf — keybindings + completion (fzf >= 0.48 ships `fzf --zsh`)
if command -v fzf >/dev/null 2>&1; then
    source <(fzf --zsh) 2>/dev/null
    export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --info=inline'
    if command -v fd >/dev/null 2>&1; then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    fi
    command -v bat >/dev/null 2>&1 && \
        export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range :300 {}'"
fi

# bat — colourful man pages
if command -v bat >/dev/null 2>&1; then
    export MANPAGER="sh -c 'col -bx | bat -l man -p'"
    export MANROFFOPT='-c'
fi

# ---------------------------------------------------------------------------
# 9. Aliases & helper functions (shared partial)
# ---------------------------------------------------------------------------
{{ template "aliases.zsh" . }}

# ---------------------------------------------------------------------------
# 10. Powerlevel10k prompt config (+ ASCII fallback for bare TTYs / no Nerd Font)
# ---------------------------------------------------------------------------
if [[ "$TERM" == "linux" || -n "${P10K_ASCII:-}" ]]; then
    typeset -g POWERLEVEL9K_MODE=ascii
fi
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# Optional system banner on new interactive shells: `export SHOW_BANNER=1`
[[ -o interactive && -n "${SHOW_BANNER:-}" && -z "$ZELLIJ" ]] && banner

# Machine-local overrides (never managed by chezmoi)
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local

# ---------------------------------------------------------------------------
# 11. zsh-syntax-highlighting — MUST be the very last thing sourced.
# ---------------------------------------------------------------------------
if [[ -r "$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
    source "$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
