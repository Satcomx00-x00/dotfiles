# ~/.config/restic/env — where the snapshots go, and how many are kept.
#
# Managed by chezmoi. Edit the source, not this file:
#     chezmoi edit ~/.config/restic/env
#
# Sourced by `dotfiles backup`, which is also what the systemd timer runs. That
# matters: a systemd unit never sources a shell rc, so anything configured in
# ~/.config/shell/local.sh would be invisible to the scheduled backup and the
# nightly run would silently use different settings from the manual one. This
# file is the single place both paths read.

# ─── Machine-specific overrides, sourced FIRST so they win ───────────────────
# ~/.config/restic/env.local is NOT managed and NOT in the repository. It is
# where an off-machine target belongs, because that line names a host:
#
#     RESTIC_REPOSITORY="sftp:backup-box:/srv/restic"
#
# Decision #30 — a hostname in a tracked file turns a public repo into a map of
# the estate. Same rule as ~/.ssh/config.d and ~/.config/shell/local.sh.
if [ -r "{{ .chezmoi.homeDir }}/.config/restic/env.local" ]; then
    . "{{ .chezmoi.homeDir }}/.config/restic/env.local"
fi

# ─── Repository ──────────────────────────────────────────────────────────────
# The default is deliberately local: it is real versioning from day one, and it
# survives the failure that actually happens weekly — deleting the wrong
# directory. It does NOT survive the disk dying, because it is on that disk.
# `dotfiles doctor` says so out loud until a second target exists, and
# docs/BACKUP.md §3 is the one line that fixes it.
: "${RESTIC_REPOSITORY:=/var/backups/restic}"

# The key to everything in the repository. Lose this file and the snapshots are
# unreadable — there is no recovery, by design. `dotfiles backup init` prints it
# once and tells you to store it somewhere that is not this machine.
: "${RESTIC_PASSWORD_FILE:={{ .chezmoi.homeDir }}/.config/restic/password}"

# ─── What is snapshotted ─────────────────────────────────────────────────────
# $HOME, minus ~/.config/restic/excludes. /etc and the package list are not
# here: they are captured as a manifest into ~/.local/state/dotfiles/system by
# `dotfiles backup system`, and ride along inside this same path. That keeps the
# scheduled backup entirely unprivileged — no root timer, no sudo in cron.
: "${BACKUP_PATHS:={{ .chezmoi.homeDir }}}"

# ─── Retention ───────────────────────────────────────────────────────────────
# Applied by `restic forget --prune` at the end of every run. Dense recent
# history for the "I broke it an hour ago" case, thinning out to a couple of
# years for the "when did this config change?" case.
: "${BACKUP_KEEP_DAILY:=7}"
: "${BACKUP_KEEP_WEEKLY:=4}"
: "${BACKUP_KEEP_MONTHLY:=12}"
: "${BACKUP_KEEP_YEARLY:=2}"

# Warn when the newest snapshot is older than this. Read by `dotfiles doctor`,
# which is the only thing standing between you and a timer that has been
# failing quietly since March.
: "${BACKUP_MAX_AGE_DAYS:=3}"

export RESTIC_REPOSITORY RESTIC_PASSWORD_FILE
