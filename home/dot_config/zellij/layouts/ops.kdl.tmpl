{{- /* `zellij --layout ops` — the shape of an incident: shell, logs, resources.
     Status bars shared from .chezmoitemplates, like every layout. */ -}}
layout {
    default_tab_template {
{{ template "zjstatus" . }}
        children
{{ template "zellij-keyhints" . }}
    }
    tab name="ops" focus=true {
        pane split_direction="horizontal" {
            pane size="60%" split_direction="vertical" {
                pane name="shell"
                pane name="logs"
            }
            pane name="resources" command="btop"
        }
    }
}
