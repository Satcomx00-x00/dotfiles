{{- /* Default layout: one pane, one status bar.

     The bar itself lives in .chezmoitemplates/zjstatus (decision #12) and is
     shared by every layout. The mode indicator matters here: decision #42
     keeps the default modal keybindings, so knowing which mode you are in —
     and what it answers to — is not optional. */ -}}
layout {
    default_tab_template {
{{ template "zjstatus" . }}
        children
    }
}
