{{- $p := .theme.palette -}}
{{- $a := .theme.ansi -}}
{{- $home := .chezmoi.homeDir -}}
// ~/.config/zellij/config.kdl — generated from .chezmoidata/*.toml.
//
// Decision #42: the DEFAULT modal keybinding scheme, unmodified. Every Zellij
// doc, issue and Stack Overflow answer then applies directly to this setup;
// zjstatus names the active mode along the top and Zellij's own status-bar
// plugin spells that mode's keys out along the bottom, at all times.
// Only these are added, all of them absent upstream:
//
//   Ctrl-h/j/k/l   unified pane/split navigation across the Neovim boundary
//   Ctrl-o w       the `room` session and project switcher
//   Alt-x, Alt-m   close / fullscreen the focused pane without entering pane
//                  mode — completing the stock Alt layer (Alt-n new, Alt-f
//                  floating, Alt-h/j/k/l focus are upstream defaults)
//
// The `zs` sessionizer (pickers.sh, Ctrl-f in the shell) creates per-project
// sessions with the dev layout; it is shell-side, so nothing here binds it.
//
// Plugin paths are absolute because Zellij's `file:` scheme does not expand ~.

theme "tokyonight"

themes {
    tokyonight {
        fg "{{ $p.fg }}"
        bg "{{ $p.bg_highlight }}"
        black "{{ $a.black }}"
        red "{{ $a.red }}"
        green "{{ $a.green }}"
        yellow "{{ $a.yellow }}"
        blue "{{ $a.blue }}"
        magenta "{{ $a.magenta }}"
        cyan "{{ $a.cyan }}"
        white "{{ $a.white }}"
        orange "{{ $p.orange }}"
    }
}

// ─── Behaviour ───────────────────────────────────────────────────────────────
default_layout "default"
default_mode "normal"
// Frames draw the border and title around each pane, so a split tells you
// which pane has focus without moving the cursor. Unconditionally — zjstatus
// deliberately does NOT set `hide_frame_for_single_pane`, so an unsplit pane
// is framed too and the viewport never resizes under you when you split.
pane_frames true
// Decision #24: leave the copy to the terminal via OSC52, so yanking on a
// REMOTE server lands in the LOCAL clipboard, over the SSH connection itself.
// Setting copy_command here would intercept that and break it.
copy_on_select true
copy_clipboard "system"
scrollback_editor "{{ .identity.editor }}"
scroll_buffer_size 20000
mouse_mode true
// Sessions are named after the host and reattached on login (decision #13);
// serialising them means a reboot does not lose the layout.
session_serialization true
pane_viewport_serialization true
show_startup_tips false
show_release_notes false

// ─── Keybindings ─────────────────────────────────────────────────────────────
// `keybinds` without `clear-defaults=true` LAYERS on top of the stock scheme,
// which is the whole point of decision #42 — Ctrl-p/t/n/o/s/g keep their
// upstream meanings and only the additions below are new.
keybinds {
    shared_except "locked" {
        // Unified navigation. The plugin checks whether the focused pane is
        // running Neovim; if so it forwards the key, otherwise it moves the
        // Zellij pane. One muscle memory across both.
        bind "Ctrl h" {
            MessagePlugin "file:{{ $home }}/.local/share/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "left";
            };
        }
        bind "Ctrl j" {
            MessagePlugin "file:{{ $home }}/.local/share/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "down";
            };
        }
        bind "Ctrl k" {
            MessagePlugin "file:{{ $home }}/.local/share/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "up";
            };
        }
        bind "Ctrl l" {
            MessagePlugin "file:{{ $home }}/.local/share/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "right";
            };
        }

        // The stock Alt layer covers new pane (Alt-n), floating (Alt-f) and
        // focus (Alt-h/j/k/l, Alt-arrows). These two complete it, so the four
        // everyday pane actions never require entering pane mode.
        bind "Alt x" { CloseFocus; }
        bind "Alt m" { ToggleFocusFullscreen; }
    }

    session {
        // `room`: fuzzy switch between sessions and project directories.
        bind "w" {
            LaunchOrFocusPlugin "file:{{ $home }}/.local/share/zellij/plugins/room.wasm" {
                floating true
            };
            SwitchToMode "Normal";
        }
    }
}
