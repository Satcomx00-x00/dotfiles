{{- $p := .theme.palette -}}
{{- $a := .theme.ansi -}}
// ~/.config/zellij/config.kdl — generated from .chezmoidata/*.toml.
//
// Decision #42: the DEFAULT modal keybinding scheme, unmodified. Every Zellij
// doc, issue and Stack Overflow answer then applies directly to this setup.
// No third-party plugins: the layouts use Zellij's built-in tab-bar and
// status-bar, and the stock session manager (Ctrl-o w) switches sessions, so
// nothing has to be downloaded or kept in step with Zellij's plugin API.
// Only these are added, both absent upstream:
//
//   Alt-x, Alt-m   close / fullscreen the focused pane without entering pane
//                  mode — completing the stock Alt layer (Alt-n new, Alt-f
//                  floating, Alt-h/j/k/l focus are upstream defaults)
//
// The `zs` sessionizer (pickers.sh, Ctrl-f in the shell) creates per-project
// sessions with the dev layout; it is shell-side, so nothing here binds it.

theme "tokyonight"

themes {
    tokyonight {
        fg "{{ $p.fg }}"
        bg "{{ $p.bg_highlight }}"
        black "{{ $a.black }}"
        red "{{ $a.red }}"
        green "{{ $a.green }}"
        yellow "{{ $a.yellow }}"
        blue "{{ $a.blue }}"
        magenta "{{ $a.magenta }}"
        cyan "{{ $a.cyan }}"
        white "{{ $a.white }}"
        orange "{{ $p.orange }}"
    }
}

// ─── Behaviour ───────────────────────────────────────────────────────────────
default_layout "default"
// Re-flow panes into a predefined layout as available space changes (on a
// terminal-window resize, or a split/close) instead of leaving gaps. This is
// Zellij's own default, pinned here so a future upstream change cannot
// silently alter how panes lay out on resize.
auto_layout true
default_mode "normal"
// Frames draw the border and title around each pane, so a split tells you
// which pane has focus without moving the cursor. An unsplit pane is framed
// too, so the viewport never resizes under you when you split.
pane_frames true
// Decision #24: leave the copy to the terminal via OSC52, so yanking on a
// REMOTE server lands in the LOCAL clipboard, over the SSH connection itself.
// Setting copy_command here would intercept that and break it.
//
// The exception is a workstation, where Zellij runs locally: there is no SSH
// hop to carry OSC52, and VTE terminals (mate-terminal, gnome-terminal, xfce4)
// drop it, so a mouse selection never reached the clipboard. Hand it straight
// to the display server instead.
copy_on_select true
copy_clipboard "system"
{{- if .fonts }}
{{-   if lookPath "wl-copy" }}
copy_command "wl-copy"
{{-   else if lookPath "xclip" }}
copy_command "xclip -selection clipboard"
{{-   end }}
{{- end }}
scrollback_editor "{{ .identity.editor }}"
scroll_buffer_size 20000
mouse_mode true
// Sessions are named after the host and reattached on login (decision #13);
// serialising them means a reboot does not lose the layout.
session_serialization true
pane_viewport_serialization true
show_startup_tips false
show_release_notes false

// ─── Keybindings ─────────────────────────────────────────────────────────────
// `keybinds` without `clear-defaults=true` LAYERS on top of the stock scheme,
// which is the whole point of decision #42 — Ctrl-p/t/n/o/s/g keep their
// upstream meanings and only the two additions below are new.
keybinds {
    shared_except "locked" {
        // The stock Alt layer covers new pane (Alt-n), floating (Alt-f) and
        // focus (Alt-h/j/k/l, Alt-arrows). These two complete it, so the four
        // everyday pane actions never require entering pane mode.
        bind "Alt x" { CloseFocus; }
        bind "Alt m" { ToggleFocusFullscreen; }
    }
}
