// ~/.config/zellij/config.kdl — managed by chezmoi.
// Zellij is a single static (musl) binary, so this config works unchanged on
// Debian/Ubuntu, Alpine, and CentOS/RHEL.

default_shell "zsh"
default_layout "default"
default_mode "normal"

// Bundled themes: catppuccin-{mocha,macchiato,frappe,latte}, dracula, nord,
// gruvbox-dark, tokyo-night, ayu, everforest-dark, … (see `zellij setup --dump-config`)
theme "catppuccin-mocha"

pane_frames true
ui {
    pane_frames {
        rounded_corners true
        hide_session_name false
    }
}
// Flip to true if your terminal/font lacks the special UI glyphs.
simplified_ui false

mouse_mode true
scroll_buffer_size 10000
scrollback_editor "nvim"

// Clipboard: no explicit copy_command, so Zellij uses the terminal's OSC 52
// clipboard — works locally AND over SSH without xclip/wl-copy installed.
copy_on_select true
copy_clipboard "system"

// Persist sessions across restarts; resurrect panes with their scrollback.
session_serialization true
serialize_pane_viewport true
on_force_close "quit"

// Keep all default keybindings, plus a quick Locked-mode toggle (Ctrl-g) so app
// shortcuts (e.g. vim Ctrl-b) pass straight through to the running program.
keybinds {
    shared_except "locked" {
        bind "Ctrl g" { SwitchToMode "Locked"; }
    }
    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }
}
