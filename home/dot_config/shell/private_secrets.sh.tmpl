# shellcheck shell=sh
# ~/.config/shell/secrets.sh — tokens resolved from Bitwarden at APPLY time.
#
# This file only exists on machines where secretsBackend = "bitwarden";
# .chezmoiignore excludes it everywhere else, so a machine without `bw` never
# renders a template that would call it (decision #16).
#
# Decision #30, and the reason this repo can be public: the item names are NOT
# in this template. They come from `secrets` in your LOCAL chezmoi config —
# ~/.config/chezmoi/chezmoi.toml, which is never committed:
#
#     [data.secrets]
#         items = [
#             { env = "GITHUB_TOKEN", item = "GitHub", field = "pat" },
#             { env = "ANTHROPIC_API_KEY", item = "Anthropic", field = "key" },
#         ]
#
# So the public repository contains the MECHANISM, and your machine contains the
# NAMES. Nothing here identifies your vault, your services or your estate.
#
# Prerequisite: `bw unlock` and `export BW_SESSION=...` before `chezmoi apply`.
# The session expires — see docs/SECRETS.md for the unhelpful error that causes.

{{/* hasKey, not a bare `.secrets` test: chezmoi runs templates with
     missingkey=error, so referencing an absent key is a hard failure rather
     than an empty value. This file must render on a machine that has never
     configured a single secret. */}}
{{- if and (hasKey . "secrets") (hasKey (default dict .secrets) "items") }}
{{- range .secrets.items }}
export {{ .env }}={{ (index (bitwardenFields "item" .item) .field).value | quote }}
{{- end }}
{{- else }}
# No [data.secrets] block in your local chezmoi config, so there is nothing to
# resolve. This is a normal, fully supported state — the Bitwarden backend is
# configured and simply has no items wired up yet. See docs/SECRETS.md.
{{- end }}
