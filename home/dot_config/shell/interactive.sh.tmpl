# shellcheck shell=sh
# ~/.config/shell/interactive.sh — interactive setup shared by bash and zsh.
#
# This is the parity seam (decision #26). Starship, zoxide, fzf, direnv and mise
# all initialise the same way in both shells, differing by one argument, so one
# file serves both and landing in bash as root feels like a plainer version of
# home rather than a different machine.
#
# ── The 60 ms budget ────────────────────────────────────────────────────────
# Naively this file forks five subprocesses per shell (starship init, zoxide
# init, fzf, direnv hook, mise activate) — 30-50 ms on its own, most of the
# budget, before a single plugin has loaded.
#
# Instead their output is generated ONCE and concatenated into a single cache
# file, which is then sourced. Steady-state cost is one `.` of a small file.
# The cache is invalidated when the set of installed tools changes (checked with
# builtins only, no forks) and deleted outright by the mise install script when
# tool versions change, so it can never go stale in a way you would notice.

# ─── Which shell are we? ─────────────────────────────────────────────────────
if [ -n "${ZSH_VERSION:-}" ]; then
    _dotfiles_shell=zsh
elif [ -n "${BASH_VERSION:-}" ]; then
    _dotfiles_shell=bash
else
    # dash/ash: no prompt, no completion, no hooks worth wiring. The aliases and
    # functions already loaded are the useful part.
    return 0
fi

# ─── Prompt glyph set (report.md §8.6) ───────────────────────────────────────
# A Linux virtual console, a serial console or a terminal without the Nerd Font
# renders the glyph prompt as a row of boxes. Both configs are generated from
# one layout, so the fallback is the same prompt in ASCII rather than a
# separate, slowly diverging config. Force either with DOTFILES_ASCII=1/0.
if [ "${DOTFILES_ASCII:-}" = 1 ] ||
    { [ "${DOTFILES_ASCII:-}" != 0 ] && case "${TERM:-}" in linux | dumb | vt* | ansi) true ;; *) false ;; esac; }; then
    [ -r "${XDG_CONFIG_HOME:-$HOME/.config}/starship-ascii.toml" ] &&
        export STARSHIP_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/starship-ascii.toml"
fi

# ─── Theme (generated from .chezmoidata/theme.toml) ──────────────────────────
# Exports FZF_DEFAULT_OPTS, EZA_COLORS, BAT_THEME and friends. Sourced before
# anything that reads them, and before fzf's keybindings are pulled from cache.
# shellcheck source=/dev/null
[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/shell/theme.sh" ] &&
    . "${XDG_CONFIG_HOME:-$HOME/.config}/shell/theme.sh"

_dotfiles_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
_dotfiles_init_cache="$_dotfiles_cache_dir/init.$_dotfiles_shell"

# Signature of what is installed right now. `command -v` is a builtin in both
# shells, so this loop costs nothing measurable.
_dotfiles_sig=''
for _t in starship zoxide fzf direnv mise; do
    if command -v "$_t" >/dev/null 2>&1; then
        _dotfiles_sig="$_dotfiles_sig:$_t"
    fi
done
unset _t

_dotfiles_cached_sig=''
if [ -r "$_dotfiles_init_cache" ]; then
    read -r _dotfiles_cached_sig <"$_dotfiles_init_cache" 2>/dev/null || :
fi

# No space after the marker: `read` strips leading and trailing IFS whitespace,
# so a "#<space><sig>" header would never compare equal to what was written and
# the cache would be rebuilt on every single shell start.
if [ "#sig$_dotfiles_sig" != "$_dotfiles_cached_sig" ]; then
    # ── Rebuild. This is the slow path, and runs about once a month. ────────
    mkdir -p "$_dotfiles_cache_dir"
    {
        printf '#sig%s\n' "$_dotfiles_sig"
        printf '# generated by ~/.config/shell/interactive.sh — do not edit\n'

        # mise first: it puts tool shims in front, and everything below may
        # itself be a mise-managed tool.
        command -v mise >/dev/null 2>&1 &&
            mise activate "$_dotfiles_shell" 2>/dev/null

        command -v starship >/dev/null 2>&1 &&
            starship init "$_dotfiles_shell" --print-full-init 2>/dev/null

        # --cmd cd makes zoxide *replace* cd rather than adding `z`, so normal
        # cd keeps working and `cd dot` also jumps by frecency (decision #21).
        command -v zoxide >/dev/null 2>&1 &&
            zoxide init "$_dotfiles_shell" --cmd cd 2>/dev/null

        # fzf >= 0.48 prints its own keybindings and completion.
        if command -v fzf >/dev/null 2>&1; then
            fzf "--$_dotfiles_shell" 2>/dev/null || :
        fi

        command -v direnv >/dev/null 2>&1 &&
            direnv hook "$_dotfiles_shell" 2>/dev/null

        :
    } >"$_dotfiles_init_cache.$$" 2>/dev/null
    mv -f "$_dotfiles_init_cache.$$" "$_dotfiles_init_cache" 2>/dev/null || :
fi

# shellcheck source=/dev/null
[ -r "$_dotfiles_init_cache" ] && . "$_dotfiles_init_cache"

unset _dotfiles_sig _dotfiles_cached_sig

# ─── GPG_TTY ─────────────────────────────────────────────────────────────────
# Set here rather than in env.sh: it needs $(tty), and env.sh runs for every
# non-interactive shell on the machine. gpg only ever needs it on a terminal.
[ -z "${GPG_TTY:-}" ] && [ -t 0 ] && GPG_TTY=$(tty 2>/dev/null) && export GPG_TTY

# A cheap monotonic clock, used by the staleness hint below. Both shells can
# provide the epoch without forking `date`; zsh needs the module loaded.
if [ -n "${ZSH_VERSION:-}" ]; then
    zmodload -F zsh/datetime b:strftime 2>/dev/null || :
fi

# ─── Transient prompt (decision #21) ─────────────────────────────────────────
# Collapses a submitted prompt to its second-line marker, so scrollback stays
# clean and only the live prompt is full width.
if command -v starship >/dev/null 2>&1; then
    if [ "$_dotfiles_shell" = zsh ]; then
        # Provided by starship's own init; guard in case of an older binary.
        command -v enable_transience >/dev/null 2>&1 && enable_transience
    fi
fi

# ─── Auto-ls on cd (decision #21) ────────────────────────────────────────────
# Suppressed above a file count, so `cd /usr/bin` does not flood the screen.
DOTFILES_AUTOLS_MAX="${DOTFILES_AUTOLS_MAX:-40}"

_dotfiles_auto_ls() {
    [ -n "${DOTFILES_AUTOLS_MAX:-}" ] || return 0
    # `ls -A | wc -l` is one fork; acceptable on an explicit directory change,
    # unlike on every prompt.
    _n=$(ls -A 2>/dev/null | wc -l)
    if [ "$_n" -gt 0 ] && [ "$_n" -le "$DOTFILES_AUTOLS_MAX" ]; then
        ls
    fi
    unset _n
}

if [ "$_dotfiles_shell" = zsh ]; then
    autoload -Uz add-zsh-hook
    add-zsh-hook chpwd _dotfiles_auto_ls
else
    # bash has no chpwd hook. Comparing $PWD in PROMPT_COMMAND is cheaper and
    # more robust than wrapping cd, which would fight zoxide for the name.
    _dotfiles_last_pwd="$PWD"
    _dotfiles_pwd_hook() {
        if [ "$PWD" != "$_dotfiles_last_pwd" ]; then
            _dotfiles_last_pwd="$PWD"
            _dotfiles_auto_ls
        fi
    }
    case "${PROMPT_COMMAND:-}" in
        *_dotfiles_pwd_hook*) ;;
        '') PROMPT_COMMAND='_dotfiles_pwd_hook' ;;
        *) PROMPT_COMMAND="_dotfiles_pwd_hook; $PROMPT_COMMAND" ;;
    esac
fi

# ─── Command-not-found installer (decision #21) ──────────────────────────────
# A missing command prints the exact command that would obtain it, and offers
# to run it. Never installs anything without an explicit `y`.
_dotfiles_not_found() {
    _cmd=$1
    printf '%s: command not found\n' "$_cmd" >&2

    _fix=''
    # ${_cmd} braced, and it must stay that way: zsh reads `$_cmd[...]` as an
    # array subscript, not as a variable followed by a bracket expression, so
    # the bare form dies with "bad output format specification" — a FATAL
    # expansion error that aborts the whole function. This handler therefore
    # printed nothing but that error on zsh, our primary shell, while working
    # perfectly on bash. Valid POSIX that zsh reinterprets is the sharp edge of
    # sharing this file between the two.
    if command -v mise >/dev/null 2>&1 && mise registry 2>/dev/null | grep -q "^${_cmd}[[:space:]]"; then
        _fix="mise use -g $_cmd@latest"
    elif command -v apt-get >/dev/null 2>&1; then
        _fix="sudo apt-get install -y $_cmd"
    elif command -v apk >/dev/null 2>&1; then
        _fix="sudo apk add $_cmd"
    elif command -v dnf >/dev/null 2>&1; then
        _fix="sudo dnf install -y $_cmd"
    elif command -v pacman >/dev/null 2>&1; then
        _fix="sudo pacman -S --noconfirm $_cmd"
    elif command -v zypper >/dev/null 2>&1; then
        _fix="sudo zypper install -y $_cmd"
    fi

    if [ -n "$_fix" ]; then
        printf '  install with: %s\n' "$_fix" >&2
        printf '  run it now? [y/N] ' >&2
        read -r _reply </dev/tty 2>/dev/null || _reply=n
        case "$_reply" in
            [yY]*) eval "$_fix" ;;
        esac
        unset _reply
    fi
    unset _cmd _fix
    return 127
}

if [ "$_dotfiles_shell" = zsh ]; then
    command_not_found_handler() { _dotfiles_not_found "$1"; }
else
    command_not_found_handle() { _dotfiles_not_found "$1"; }
fi

{{- if .staleness }}

# ─── Staleness hint (decision #34) ───────────────────────────────────────────
# Manual updates only, so after 7 days a single subtle line appears, at most
# once a day. A local file-timestamp comparison: no network call, no git
# invocation, nothing that could slow or hang a shell on a bad connection.
_dotfiles_staleness_hint() {
    _stamp="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/last-apply"
    _shown="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/last-hint"
    [ -f "$_stamp" ] || { unset _stamp _shown; return 0; }

    # $EPOCHSECONDS and `read` are builtins in both shells. The obvious spelling
    # of this function — date, cat, cat — is three forks on every interactive
    # shell to usually decide there is nothing to say.
    _now=${EPOCHSECONDS:-}
    [ -n "$_now" ] || _now=$(date +%s)
    _then=$_now
    read -r _then <"$_stamp" 2>/dev/null || :
    case "$_then" in '' | *[!0-9]*) _then=$_now ;; esac
    _days=$(((_now - _then) / 86400))

    if [ "$_days" -ge 7 ]; then
        # At most one hint per calendar day.
        _last=0
        read -r _last <"$_shown" 2>/dev/null || :
        case "$_last" in '' | *[!0-9]*) _last=0 ;; esac
        if [ $((_now - _last)) -ge 86400 ]; then
            printf '\033[2mdotfiles: %s days since the last update — `dotfiles update`\033[0m\n' "$_days"
            mkdir -p -- "$(dirname -- "$_shown")"
            printf '%s\n' "$_now" >"$_shown"
        fi
        unset _last
    fi
    unset _stamp _shown _now _then _days
}
_dotfiles_staleness_hint
{{- end }}

unset _dotfiles_shell
return 0
