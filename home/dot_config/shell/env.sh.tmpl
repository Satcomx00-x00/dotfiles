# shellcheck shell=sh
# ~/.config/shell/env.sh — environment for EVERY shell, everywhere.
#
# Strictly POSIX: this file is sourced by dash, ash (BusyBox), bash and zsh, in
# login shells, non-login shells, and non-interactive script shells. It must
# never print output, never assume bash/zsh syntax, and never be slow.
#
# Sourced from: ~/.zshenv, ~/.profile (and therefore ~/.bash_profile).

# Guard against double-sourcing (zsh sources .zshenv then .zprofile then .zshrc).
[ -n "${DOTFILES_ENV_LOADED:-}" ] && return 0
DOTFILES_ENV_LOADED=1

# ─── XDG base directories ────────────────────────────────────────────────────
# Everything in this repo is XDG-first; setting these explicitly means the same
# paths resolve on a distro whose /etc/profile forgot to define them.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_BIN_HOME="${XDG_BIN_HOME:-$HOME/.local/bin}"

# ─── PATH ────────────────────────────────────────────────────────────────────
# POSIX-safe prepend that refuses duplicates, so re-sourcing never grows PATH.
_dotfiles_path_prepend() {
    case ":${PATH}:" in
        *":$1:"*) ;;
        *) [ -d "$1" ] && PATH="$1:${PATH}" ;;
    esac
}

export GOPATH="${GOPATH:-$HOME/go}"
export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"

# Lowest priority first — each prepend pushes the previous one down.
_dotfiles_path_prepend "$GOPATH/bin"
_dotfiles_path_prepend "$CARGO_HOME/bin"
_dotfiles_path_prepend "$HOME/bin"
_dotfiles_path_prepend "$XDG_BIN_HOME"
export PATH

# ─── Locale ──────────────────────────────────────────────────────────────────
# C.UTF-8 exists on every modern libc (including musl/Alpine) and never triggers
# the "setlocale: LC_ALL: cannot change locale" noise that en_US.UTF-8 causes on
# minimal images. Override in ~/.config/shell/local.sh if you need a real locale.
export LANG="${LANG:-C.UTF-8}"
export LC_ALL="${LC_ALL:-}"

# ─── Editor & pager ──────────────────────────────────────────────────────────
# Fall back down the chain so a box without the preferred editor still works.
if command -v {{ .editor }} >/dev/null 2>&1; then
    export EDITOR="{{ .editor }}"
elif command -v nvim >/dev/null 2>&1; then
    export EDITOR="nvim"
elif command -v vim >/dev/null 2>&1; then
    export EDITOR="vim"
else
    export EDITOR="vi"
fi
export VISUAL="$EDITOR"
export SUDO_EDITOR="$EDITOR"

export PAGER="less"
export LESS="-R -F -X -i -M -w -z-4"
export LESSHISTFILE="$XDG_STATE_HOME/less/history"

# ─── XDG cleanup: keep $HOME free of tool droppings ──────────────────────────
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"
export GNUPGHOME="$XDG_DATA_HOME/gnupg"
export KUBECACHEDIR="$XDG_CACHE_HOME/kube"
# Only relocate kubeconfig if the XDG copy actually exists — pointing KUBECONFIG
# at a missing file would break kubectl on every box using the classic path.
if [ -z "${KUBECONFIG:-}" ] && [ -f "$XDG_CONFIG_HOME/kube/config" ]; then
    export KUBECONFIG="$XDG_CONFIG_HOME/kube/config"
fi
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME/npm/npmrc"
export NODE_REPL_HISTORY="$XDG_STATE_HOME/node_repl_history"
export PYTHONPYCACHEPREFIX="$XDG_CACHE_HOME/python"
export PYTHON_HISTORY="$XDG_STATE_HOME/python_history"
export RUSTUP_HOME="$XDG_DATA_HOME/rustup"
export GRADLE_USER_HOME="$XDG_DATA_HOME/gradle"
export AWS_SHARED_CREDENTIALS_FILE="$XDG_CONFIG_HOME/aws/credentials"
export AWS_CONFIG_FILE="$XDG_CONFIG_HOME/aws/config"
export TERRAFORM_CLI_CONFIG_FILE="$XDG_CONFIG_HOME/terraform/terraformrc"

# ─── Tooling defaults ────────────────────────────────────────────────────────
export GPG_TTY="${GPG_TTY:-$(tty 2>/dev/null || echo /dev/null)}"

# Colour output when the terminal supports it, plain text when piped.
export CLICOLOR=1

# Ripgrep reads its config from a file, not env flags.
export RIPGREP_CONFIG_PATH="$XDG_CONFIG_HOME/ripgrep/config"

# mise: never nag about missing tools on a box that intentionally has fewer.
export MISE_NOT_FOUND_AUTO_INSTALL="${MISE_NOT_FOUND_AUTO_INSTALL:-1}"

{{- if eq .profile "server" }}

# ─── Server profile ──────────────────────────────────────────────────────────
# No multiplexer autostart, and a smaller Node heap since servers are usually
# memory-constrained relative to a workstation.
export DOTFILES_PROFILE="server"
export NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=2048}"
{{- else if eq .profile "container" }}

# ─── Container profile ───────────────────────────────────────────────────────
export DOTFILES_PROFILE="container"
{{- else }}

# ─── Workstation profile ─────────────────────────────────────────────────────
export DOTFILES_PROFILE="workstation"
export NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=8192}"
{{- end }}

# ─── WSL2 interop ────────────────────────────────────────────────────────────
# Windows PATH entries leak into WSL and make every command lookup slow (and
# `ls` on /mnt/c crawl). Keep the useful bridges, drop the rest.
if [ -n "${WSL_DISTRO_NAME:-}" ] || grep -qi microsoft /proc/version 2>/dev/null; then
    export DOTFILES_WSL=1
    export BROWSER="${BROWSER:-wslview}"
    # Route DISPLAY through WSLg when present; otherwise leave it unset so
    # nothing tries to open a window that cannot appear.
    [ -d /mnt/wslg ] && export DISPLAY="${DISPLAY:-:0}"
fi

# ─── Machine-local overrides (never managed by chezmoi, never committed) ─────
[ -r "$XDG_CONFIG_HOME/shell/local.sh" ] && . "$XDG_CONFIG_HOME/shell/local.sh"

return 0
