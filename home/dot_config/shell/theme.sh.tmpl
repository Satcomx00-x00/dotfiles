# shellcheck shell=sh
# ~/.config/shell/theme.sh — Tokyo Night for everything that takes its colours
# from an environment variable rather than a config file.
#
# Generated from .chezmoidata/theme.toml. Sourced by interactive.sh before fzf's
# keybindings are loaded, so the pickers come up already themed.
#
# Do not edit: change the palette in the data file and re-apply.

{{- $p := .theme.palette }}
{{- $r := .theme.roles }}
{{- $u := .theme.ui }}

# ─── bat ─────────────────────────────────────────────────────────────────────
export BAT_THEME="{{ .theme.bat }}"

# man pages through bat, when it exists.
if command -v bat > /dev/null 2>&1; then
    export MANPAGER="sh -c 'col -bx | bat -l man -p'"
    export MANROFFOPT="-c"
fi

# ─── fzf ─────────────────────────────────────────────────────────────────────
# Every picker in pickers.sh, fzf-tab's completion menu, and Ctrl-r/Ctrl-t all
# inherit this, so the whole fuzzy-finding surface matches in one assignment.
export FZF_DEFAULT_OPTS="\
--height=60% --layout=reverse --border=rounded --info=inline \
--color=fg:{{ $p.fg_dark }},bg:-1,hl:{{ $p.blue }} \
--color=fg+:{{ $p.fg }},bg+:{{ $u.selection_bg }},hl+:{{ $p.cyan }} \
--color=info:{{ $p.purple }},prompt:{{ $p.cyan }},pointer:{{ $r.urgent }} \
--color=marker:{{ $p.green }},spinner:{{ $p.magenta }},header:{{ $p.blue7 }} \
--color=border:{{ $u.border }},gutter:-1 \
--prompt='  ' --pointer='▎' --marker='✓'"

# Respect .gitignore and show hidden files, but never descend into .git.
if command -v fd > /dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
fi
export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always --line-range=:200 {} 2>/dev/null || head -200 {}' --preview-window=right:60%:wrap"
export FZF_ALT_C_OPTS="--preview 'eza -la --icons=auto --color=always {} 2>/dev/null || ls -la {}' --preview-window=right:60%"
export FZF_CTRL_R_OPTS="--preview 'echo {}' --preview-window=down:3:wrap --exact"

# ─── eza ─────────────────────────────────────────────────────────────────────
# ui=xx pairs are eza's own keys: user, group, size numbers/units, dates,
# permission bits, and git status columns.
export EZA_COLORS="\
da={{ $p.comment }}:\
uu={{ $p.green }}:un={{ $p.comment }}:\
gu={{ $p.green1 }}:gn={{ $p.comment }}:\
sn={{ $p.cyan }}:sb={{ $p.blue1 }}:\
ur={{ $p.yellow }}:uw={{ $p.red }}:ux={{ $p.green }}:ue={{ $p.green }}:\
gr={{ $p.yellow }}:gw={{ $p.red }}:gx={{ $p.green }}:\
tr={{ $p.yellow }}:tw={{ $p.red }}:tx={{ $p.green }}:\
ga={{ $r.added }}:gm={{ $r.changed }}:gd={{ $r.removed }}:\
di={{ $p.blue }}:ln={{ $p.cyan }}:ex={{ $p.green }}"

# ─── ls fallback ─────────────────────────────────────────────────────────────
# Only used on machines without eza, but the completion menu reads LS_COLORS
# too, so it is always worth setting.
export LS_COLORS="di=1;34:ln=1;36:so=1;35:pi=1;33:ex=1;32:bd=1;33:cd=1;33:su=1;31:sg=1;31:tw=1;34:ow=1;34"

# ─── delta ───────────────────────────────────────────────────────────────────
# The rest of delta's configuration lives in ~/.config/git/config; only the
# theme name is shared here so `bat` and `git diff` agree on syntax colours.
export DELTA_FEATURES=tokyonight

return 0
