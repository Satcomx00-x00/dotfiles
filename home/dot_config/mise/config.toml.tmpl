# ~/.config/mise/config.toml — global tool & runtime manager (auto-trusted).
# Bare tool names resolve through the mise registry (aqua/ubi/core backends), so
# binaries have their canonical names on every distro. Edit + `chezmoi apply`;
# the run_onchange mise hook reinstalls whatever changed.

[tools]
# --- language runtimes (loose major pins; per-project versions still win) ---
node    = "22"
python  = "3.12"
uv      = "latest"
bun     = "latest"
neovim  = "latest"

# --- modern CLI core ---
eza     = "latest"
bat     = "latest"
fd      = "latest"
ripgrep = "latest"
fzf     = "latest"
zoxide  = "latest"
delta   = "latest"
jq      = "latest"
yq      = "latest"
gh      = "latest"
lazygit = "latest"
zellij  = "latest"
btop    = "latest"

# --- devops / cloud ---
kubectl   = "latest"
k9s       = "latest"
helm      = "latest"
kubectx   = "latest"
lazydocker = "latest"
awscli    = "latest"
terraform = "1.9"

[settings]
# Interop with .nvmrc / .python-version etc.
idiomatic_version_file_enable_tools = ["node", "python"]
# Parallel installs
jobs = 4
# Auto-install a missing version when you cd into a project that needs it
not_found_auto_install = true
# Less noisy "missing tool" chatter
status = { missing_tools = "if_other_versions_installed" }

[env]
EDITOR = "{{ .editor }}"
# Prepend ~/.local/bin for any hand-installed binaries
_.path = ["~/.local/bin"]
