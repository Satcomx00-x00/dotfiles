{{- $p := .theme.palette -}}
{{- $r := .theme.roles -}}
{{- $u := .theme.ui -}}
# Tokyo Night for btop — generated from .chezmoidata/theme.toml.
#
# btop keeps colours in a theme file rather than its main config, which is why
# this file and not btop.conf is the palette's consumer.

theme[main_bg]="{{ $p.bg }}"
theme[main_fg]="{{ $p.fg }}"
theme[title]="{{ $p.fg }}"
theme[hi_fg]="{{ $p.blue }}"
theme[selected_bg]="{{ $u.selection_bg }}"
theme[selected_fg]="{{ $p.fg }}"
theme[inactive_fg]="{{ $p.comment }}"
theme[graph_text]="{{ $p.fg_dark }}"
theme[meter_bg]="{{ $p.bg_highlight }}"
theme[proc_misc]="{{ $p.green1 }}"

# Box outlines
theme[cpu_box]="{{ $p.blue7 }}"
theme[mem_box]="{{ $p.blue7 }}"
theme[net_box]="{{ $p.blue7 }}"
theme[proc_box]="{{ $p.blue7 }}"
theme[div_line]="{{ $u.border }}"

# Temperature: safe -> warm -> hot
theme[temp_start]="{{ $r.ok }}"
theme[temp_mid]="{{ $r.warning }}"
theme[temp_end]="{{ $r.error }}"

# CPU load gradient
theme[cpu_start]="{{ $p.green1 }}"
theme[cpu_mid]="{{ $p.blue }}"
theme[cpu_end]="{{ $p.magenta }}"

# Memory: free / cached / available / used
theme[free_start]="{{ $p.green }}"
theme[free_mid]="{{ $p.green2 }}"
theme[free_end]="{{ $p.teal }}"
theme[cached_start]="{{ $p.cyan }}"
theme[cached_mid]="{{ $p.blue1 }}"
theme[cached_end]="{{ $p.blue2 }}"
theme[available_start]="{{ $p.yellow }}"
theme[available_mid]="{{ $p.orange }}"
theme[available_end]="{{ $p.orange }}"
theme[used_start]="{{ $p.red }}"
theme[used_mid]="{{ $p.red1 }}"
theme[used_end]="{{ $r.urgent }}"

# Network throughput
theme[download_start]="{{ $p.purple }}"
theme[download_mid]="{{ $p.magenta }}"
theme[download_end]="{{ $p.blue }}"
theme[upload_start]="{{ $p.green1 }}"
theme[upload_mid]="{{ $p.green2 }}"
theme[upload_end]="{{ $p.teal }}"

# Process box gradient
theme[process_start]="{{ $p.blue }}"
theme[process_mid]="{{ $p.purple }}"
theme[process_end]="{{ $p.magenta }}"
