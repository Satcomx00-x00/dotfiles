{{- $t := .theme.terminal -}}
{{- $a := .theme.terminal.ansi -}}
# ~/.config/ghostty/config — generated from .chezmoidata/theme.toml.
#
# Config only (report.md §7.14): Ghostty is a GUI application you install
# yourself. Applied on `workstation` profiles only — .chezmoiignore drops this
# whole directory elsewhere, because a terminal emulator config on a headless
# server is inert.

# ─── Font ────────────────────────────────────────────────────────────────────
font-family = JetBrainsMono Nerd Font
font-size = 13
font-feature = -calt
font-feature = -liga
adjust-cell-height = 12%

# ─── Theme ───────────────────────────────────────────────────────────────────
# xcad2k dark — [theme.terminal], NOT the Tokyo Night palette the rest of the
# repo uses. Read the comment there before touching a slot: the ANSI ring is
# deliberately one violet ramp, so `red` being a purple is intended.
background = {{ $t.bg }}
foreground = {{ $t.fg }}
cursor-color = {{ $t.cursor }}
cursor-text = {{ $t.cursor_text }}
selection-background = {{ $t.selection_bg }}
selection-foreground = {{ $t.selection_fg }}

palette = 0={{ $a.black }}
palette = 1={{ $a.red }}
palette = 2={{ $a.green }}
palette = 3={{ $a.yellow }}
palette = 4={{ $a.blue }}
palette = 5={{ $a.magenta }}
palette = 6={{ $a.cyan }}
palette = 7={{ $a.white }}
palette = 8={{ $a.bright_black }}
palette = 9={{ $a.bright_red }}
palette = 10={{ $a.bright_green }}
palette = 11={{ $a.bright_yellow }}
palette = 12={{ $a.bright_blue }}
palette = 13={{ $a.bright_magenta }}
palette = 14={{ $a.bright_cyan }}
palette = 15={{ $a.bright_white }}

# ─── Window ──────────────────────────────────────────────────────────────────
window-padding-x = 8
window-padding-y = 4
window-decoration = true
window-theme = ghostty
confirm-close-surface = false
# Zellij manages splits and tabs (decision #11). A second layer of them here
# means two keymaps for the same job.
window-inherit-working-directory = true

# ─── Behaviour ───────────────────────────────────────────────────────────────
# Decision #24: let OSC52 through. This is the setting that makes a yank inside
# Neovim on a remote server land in the local clipboard.
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true
copy-on-select = clipboard

scrollback-limit = 10000000
mouse-hide-while-typing = true
shell-integration = detect
shell-integration-features = cursor,sudo,title

# Zellij owns Ctrl-based keys; keep the emulator's bindings out of its way.
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
