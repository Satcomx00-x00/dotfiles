# ~/.config/git/ignore — the global ignore list.
#
# Only things that are never worth committing on ANY machine. Project-specific
# ignores belong in the project's own .gitignore, where a collaborator can see
# them; putting them here silently breaks the repo for everyone else.

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── Editors ───────────────────────────────────────────────────────────────────
*.swp
*.swo
*~
.idea/
*.iml
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.nvim.lua
.exrc

# ── Direnv and local tooling state ────────────────────────────────────────────
.direnv/
.envrc.local
.tool-versions.local

# ── Secrets — belt and braces alongside gitleaks (decision #19) ───────────────
.env
.env.local
.env.*.local
*.pem
*.key
!*.pub
id_rsa
id_ed25519
.netrc

# ── Build and dependency output ───────────────────────────────────────────────
*.pyc
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
node_modules/
.terraform/
*.tfstate.backup
.venv/
