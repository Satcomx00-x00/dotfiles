#!/bin/sh
# claude-or — Claude Code on OpenRouter, plus the global on/off switch.
#
# POSIX-sh counterpart of the Windows wrapper in ~/.local/bin/claude-or.ps1.
# Managed by chezmoi: edit home/dot_local/bin/executable_claude-or, never the
# rendered copy in ~/.local/bin.
#
# Switch commands (persist in ~/.config/claude-or/env.sh, sourced by every
# shell from ~/.config/shell/env.sh):
#   enable     route every `claude` to OpenRouter + DeepSeek
#   disable    route every `claude` back to your Anthropic account
#   toggle     flip whichever is currently active
#   status     show what is active (reads the switch file, not this shell)
#
# Launch options (anything unclaimed is forwarded to claude verbatim):
#   -Model <slug>      pin the main model (Sonnet + Opus + sub-agents)
#   -Sonnet <slug>     ANTHROPIC_DEFAULT_SONNET_MODEL
#   -Opus <slug>       ANTHROPIC_DEFAULT_OPUS_MODEL   (what -p / SDK uses)
#   -Fable <slug>      ANTHROPIC_DEFAULT_FABLE_MODEL  (heaviest class)
#   -Haiku <slug>      ANTHROPIC_DEFAULT_HAIKU_MODEL
#   -Subagent <slug>   CLAUDE_CODE_SUBAGENT_MODEL
#   -Discover          enable the OpenRouter gateway model picker (/model)
#   -Print             print resolved config and exit (does not launch)
#   --or-help          show this help
#   --                 pass everything after this to claude untouched
#
# The CamelCase spellings mirror the Windows wrapper; every one also has a
# GNU-style alias (--or-model, --or-sonnet, ...). A flag Claude Code owns,
# such as --model or -p, is never claimed here and reaches claude unchanged.
#
# Examples:
#   claude-or enable
#   claude-or status
#   claude-or -p "explain this repo"
#   claude-or -Model 'deepseek/deepseek-v4-pro[1m]'
#   claude-or -- enable            # send the literal word "enable" to claude

set -eu

CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
PROFILE_ROOT=${CLAUDE_OR_PROFILE:-$HOME/.claude-profiles/openrouter}
STATE_DIR=${CLAUDE_OR_STATE_DIR:-$CONFIG_HOME/claude-or}
SWITCH_FILE=$STATE_DIR/env.sh
KEY_FILE=$PROFILE_ROOT/openrouter.key

# Keep these in sync with the Windows wrapper (cc-profiles-setup.ps1).
# Every DeepSeek v4 model below has a 1M window, hence the [1m] marker: it stops
# Claude Code compacting at 200k, and OpenRouter strips it before routing.
DEFAULT_FABLE='deepseek/deepseek-v4-pro[1m]'
DEFAULT_OPUS='deepseek/deepseek-v4.1-flash-1017[1m]'
DEFAULT_SONNET='deepseek/deepseek-v4.1-flash-1017[1m]'
DEFAULT_HAIKU='deepseek/deepseek-v4-flash-0731[1m]'
DEFAULT_SUBAGENT='deepseek/deepseek-v4.1-flash-1017[1m]'

BASE_URL='https://openrouter.ai/api'

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_DIM=$(printf '\033[2m')
    C_RED=$(printf '\033[31m')
    C_GREEN=$(printf '\033[32m')
    C_YELLOW=$(printf '\033[33m')
    C_RESET=$(printf '\033[0m')
else
    C_DIM='' C_RED='' C_GREEN='' C_YELLOW='' C_RESET=''
fi

ok() { printf '%s%s%s\n' "$C_GREEN" "$*" "$C_RESET"; }
warn() { printf '%s%s%s\n' "$C_YELLOW" "$*" "$C_RESET"; }
dim() { printf '%s%s%s\n' "$C_DIM" "$*" "$C_RESET"; }
err() { printf '%s%s%s\n' "$C_RED" "$*" "$C_RESET" >&2; }
die() {
    err "$*"
    exit 1
}

# ─── Key storage ─────────────────────────────────────────────────────────────
# A 0600 file, the same trust model as ~/.ssh and ~/.aws. There is no DPAPI on
# Linux; a keyring would make the command unusable over SSH or in a container,
# which is exactly where this launcher is most useful.
read_key() {
    [ -r "$KEY_FILE" ] || return 1
    _stored=$(cat -- "$KEY_FILE" 2> /dev/null) || return 1
    [ -n "$_stored" ] || return 1
    printf '%s' "$_stored"
}

mask() {
    if [ "${#1}" -gt 12 ]; then
        _first=${1%"${1#????????}"}
        _last=${1#"${1%????}"}
        printf '%s...%s' "$_first" "$_last"
    else
        printf '<set>'
    fi
}

# ─── Switch state ────────────────────────────────────────────────────────────
switch_enabled() { [ -f "$SWITCH_FILE" ]; }

write_switch() {
    # The file is shell code, so the path is single-quoted. A path containing a
    # quote is refused rather than mis-encoded; OpenRouter keys never reach this
    # file, they are read from the 0600 key file below.
    case $PROFILE_ROOT in
        *"'"*) die "cannot encode a single quote in the switch file: $PROFILE_ROOT" ;;
    esac

    umask 077
    mkdir -p "$STATE_DIR"
    chmod 700 "$STATE_DIR" 2> /dev/null || :
    {
        printf '%s\n' '# Generated by `claude-or enable`; do not edit.'
        printf '%s\n' '# Removed by `claude-or disable`. Sourced by ~/.config/shell/env.sh.'
        printf "export CLAUDE_CONFIG_DIR='%s'\n" "$PROFILE_ROOT"
        printf "export ANTHROPIC_BASE_URL='%s'\n" "$BASE_URL"
        # read is a shell builtin: no fork on shell startup, and the key stays
        # in exactly one file so --set-key rotates it without rewriting this.
        printf "if [ -r '%s' ]; then\n" "$KEY_FILE"
        printf "    IFS= read -r ANTHROPIC_AUTH_TOKEN < '%s' || :\n" "$KEY_FILE"
        printf '    export ANTHROPIC_AUTH_TOKEN\n'
        printf 'else\n'
        printf '    unset ANTHROPIC_AUTH_TOKEN\n'
        printf 'fi\n'
        printf '%s\n' 'unset ANTHROPIC_API_KEY'
        printf "export ANTHROPIC_DEFAULT_FABLE_MODEL='%s'\n" "$DEFAULT_FABLE"
        printf "export ANTHROPIC_DEFAULT_OPUS_MODEL='%s'\n" "$DEFAULT_OPUS"
        printf "export ANTHROPIC_DEFAULT_SONNET_MODEL='%s'\n" "$DEFAULT_SONNET"
        printf "export ANTHROPIC_DEFAULT_HAIKU_MODEL='%s'\n" "$DEFAULT_HAIKU"
        printf "export CLAUDE_CODE_SUBAGENT_MODEL='%s'\n" "$DEFAULT_SUBAGENT"
        printf "export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY='0'\n"
    } > "$SWITCH_FILE"
    chmod 600 "$SWITCH_FILE"
}

cmd_enable() {
    if ! read_key > /dev/null; then
        warn 'No OpenRouter API key stored yet.'
        printf 'Store it once: claude-or-key --set-key\n'
        return 1
    fi
    write_switch
    ok 'Claude Code -> OpenRouter + DeepSeek   [ENABLED]'
    dim "  main model: $DEFAULT_SONNET"
    dim '  new shells pick this up automatically.'
    dim "  this shell now: . $SWITCH_FILE"
    return 0
}

cmd_disable() {
    rm -f "$SWITCH_FILE"
    ok 'Claude Code -> Anthropic account        [DISABLED]'
    dim '  your normal ~/.claude login and settings are used again.'
    dim '  open a new shell (or: exec zsh -l) to clear this one.'
    return 0
}

show_status() {
    _enabled=0
    switch_enabled && _enabled=1

    _base='' _dir='' _model=''
    if [ "$_enabled" -eq 1 ]; then
        _base=$(sed -n "s/^export ANTHROPIC_BASE_URL='\(.*\)'$/\1/p" "$SWITCH_FILE" | head -n 1)
        _dir=$(sed -n "s/^export CLAUDE_CONFIG_DIR='\(.*\)'$/\1/p" "$SWITCH_FILE" | head -n 1)
        _model=$(sed -n "s/^export ANTHROPIC_DEFAULT_SONNET_MODEL='\(.*\)'$/\1/p" "$SWITCH_FILE" | head -n 1)
    fi
    [ -n "$_base" ] || _base=$BASE_URL
    [ -n "$_dir" ] || _dir=$PROFILE_ROOT

    _token='<none>'
    if _stored=$(read_key); then
        _token=$(mask "$_stored")
    fi

    if [ "$_enabled" -eq 1 ]; then
        if [ -n "${ANTHROPIC_API_KEY+x}" ]; then
            _apikey='<set> (should be unset)'
        else
            _apikey='<unset> (correct)'
        fi
        _want=$_base
    else
        if [ -n "${ANTHROPIC_API_KEY+x}" ]; then
            _apikey='<set>'
        else
            _apikey='<unset>'
        fi
        _want=''
    fi

    if [ "${ANTHROPIC_BASE_URL:-}" = "$_want" ]; then
        _sync='in sync'
    else
        _sync='STALE - new shell, or: . '"$SWITCH_FILE"
    fi

    printf '\n'
    if [ "$_enabled" -eq 1 ]; then
        ok '  Claude Code: OpenRouter + DeepSeek   [ENABLED]'
    else
        warn '  Claude Code: Anthropic account       [DISABLED]'
    fi
    printf '\n'
    printf '  %-14s %s\n' 'base URL' "$(if [ "$_enabled" -eq 1 ]; then printf '%s' "$_base"; else printf '<default: Anthropic direct>'; fi)"
    printf '  %-14s %s\n' 'profile dir' "$(if [ "$_enabled" -eq 1 ]; then printf '%s' "$_dir"; else printf '<default: %s/.claude>' "$HOME"; fi)"
    printf '  %-14s %s\n' 'auth token' "$_token"
    printf '  %-14s %s\n' 'API key var' "$_apikey"
    printf '  %-14s %s\n' 'main model' "$(if [ "$_enabled" -eq 1 ]; then printf '%s' "$_model"; else printf '<your Anthropic default>'; fi)"
    printf '\n'
    printf '  %-14s %s\n' 'this shell' "$_sync"
    if _stored=$(read_key); then
        printf '  %-14s yes (%s)\n' 'stored key' "$KEY_FILE"
    else
        printf '  %-14s no - run: claude-or-key --set-key\n' 'stored key'
    fi
    printf '\n'
}

show_help() {
    cat << 'EOF'
claude-or — Claude Code on OpenRouter, plus the global on/off switch.

Switch commands (apply to every `claude` invocation in a new shell):
  enable     route every `claude` to OpenRouter + DeepSeek
  disable    route every `claude` back to your Anthropic account
  toggle     flip whichever is currently active
  status     show what is active (reads the switch file, not this shell)

Launch options (flags you do not claim are forwarded to claude verbatim):
  -Model <slug>      pin the main model (Sonnet + Opus + sub-agents)
  -Sonnet <slug>     ANTHROPIC_DEFAULT_SONNET_MODEL
  -Opus <slug>       ANTHROPIC_DEFAULT_OPUS_MODEL   (what -p / SDK uses)
  -Fable <slug>      ANTHROPIC_DEFAULT_FABLE_MODEL  (heaviest class)
  -Haiku <slug>      ANTHROPIC_DEFAULT_HAIKU_MODEL
  -Subagent <slug>   CLAUDE_CODE_SUBAGENT_MODEL
  -Discover          enable the OpenRouter gateway model picker (/model)
  -Print             print resolved config and exit (does not launch)
  --or-help          this help
  --                 pass everything after this to claude untouched

GNU-style aliases exist for every CamelCase option: --or-model, --or-sonnet,
--or-opus, --or-fable, --or-haiku, --or-subagent, --or-discover, --or-print.

Examples:
  claude-or enable
  claude-or disable
  claude-or status
  claude-or                              # per-session, switch untouched
  claude-or -p "explain this repo"
  claude-or -Model 'deepseek/deepseek-v4-pro[1m]'
  claude-or -- enable                    # send the literal word "enable" to claude

Key management:
  claude-or-key --set-key                # store the key once (mode 600)
  claude-or-key --status                 # remaining OpenRouter credit
  claude-or-status                       # same as --status
EOF
}

# ─── Argument parsing ────────────────────────────────────────────────────────
# No arrays in POSIX sh. Each argument is consumed from the front and, when it
# is not a wrapper option, appended to the back; the counter bounds the loop.
# Order survives the rotation, and arguments are never re-parsed with eval, so
# spaces, globs and quotes reach claude exactly as typed.
cfg_fable=$DEFAULT_FABLE
cfg_opus=$DEFAULT_OPUS
cfg_sonnet=$DEFAULT_SONNET
cfg_haiku=$DEFAULT_HAIKU
cfg_subagent=$DEFAULT_SUBAGENT
cfg_model=''
discover=0
show_cfg=0
show_help_flag=0
switch_cmd=''
npass=0
remaining=$#

while [ "$remaining" -gt 0 ]; do
    tok=$1
    shift
    remaining=$((remaining - 1))

    case $tok in
        --)
            # Everything after the separator is for claude, even a bare word
            # that would otherwise be read as a switch command.
            while [ "$remaining" -gt 0 ]; do
                _t=$1
                shift
                remaining=$((remaining - 1))
                set -- "$@" "$_t"
            done
            break
            ;;
        -[Pp]rint | --or-print)
            show_cfg=1
            continue
            ;;
        -[Dd]iscover | --or-discover)
            discover=1
            continue
            ;;
        --or-help | -orhelp)
            show_help_flag=1
            continue
            ;;
        -[Mm]odel=* | --or-model=*)
            cfg_model=${tok#*=}
            continue
            ;;
        -[Ss]onnet=* | --or-sonnet=*)
            cfg_sonnet=${tok#*=}
            continue
            ;;
        -[Oo]pus=* | --or-opus=*)
            cfg_opus=${tok#*=}
            continue
            ;;
        -[Ff]able=* | --or-fable=*)
            cfg_fable=${tok#*=}
            continue
            ;;
        -[Hh]aiku=* | --or-haiku=*)
            cfg_haiku=${tok#*=}
            continue
            ;;
        -[Ss]ubagent=* | --or-subagent=*)
            cfg_subagent=${tok#*=}
            continue
            ;;
    esac

    _opt=''
    case $tok in
        -[Mm]odel | --or-model) _opt=Model ;;
        -[Ss]onnet | --or-sonnet) _opt=Sonnet ;;
        -[Oo]pus | --or-opus) _opt=Opus ;;
        -[Ff]able | --or-fable) _opt=Fable ;;
        -[Hh]aiku | --or-haiku) _opt=Haiku ;;
        -[Ss]ubagent | --or-subagent) _opt=Subagent ;;
    esac

    if [ -n "$_opt" ]; then
        if [ "$remaining" -lt 1 ]; then
            err "$tok needs a value"
            exit 2
        fi
        _val=$1
        shift
        remaining=$((remaining - 1))
        case $_opt in
            Model) cfg_model=$_val ;;
            Sonnet) cfg_sonnet=$_val ;;
            Opus) cfg_opus=$_val ;;
            Fable) cfg_fable=$_val ;;
            Haiku) cfg_haiku=$_val ;;
            Subagent) cfg_subagent=$_val ;;
        esac
        continue
    fi

    # The first bare word may be a switch command. `claude-or -- status` skips
    # this branch because the separator already consumed everything.
    if [ -z "$switch_cmd" ] && [ "$npass" -eq 0 ]; then
        case $tok in
            enable | on) switch_cmd=enable ;;
            disable | off) switch_cmd=disable ;;
            toggle) switch_cmd=toggle ;;
            status) switch_cmd=status ;;
        esac
        if [ -n "$switch_cmd" ]; then
            continue
        fi
    fi

    set -- "$@" "$tok"
    npass=$((npass + 1))
done

if [ "$show_help_flag" -eq 1 ]; then
    show_help
    exit 0
fi

case $switch_cmd in
    enable)
        cmd_enable
        exit $?
        ;;
    disable)
        cmd_disable
        exit $?
        ;;
    toggle)
        if switch_enabled; then
            cmd_disable
        else
            cmd_enable
        fi
        exit $?
        ;;
    status)
        show_status
        exit 0
        ;;
esac

# -Model is the shorthand that must win in every mode, including -p / SDK.
if [ -n "$cfg_model" ]; then
    cfg_sonnet=$cfg_model
    cfg_opus=$cfg_model
    cfg_subagent=$cfg_model
fi

if [ "$show_cfg" -eq 1 ]; then
    _masked='<none>'
    if _stored=$(read_key); then
        _masked=$(mask "$_stored")
    fi
    printf '%s\n' 'Mode               : one-shot (the enable/disable switch is not consulted)'
    printf '%-18s: %s\n' 'CLAUDE_CONFIG_DIR' "$PROFILE_ROOT"
    printf '%-18s: %s\n' 'ANTHROPIC_BASE_URL' "$BASE_URL"
    printf '%-18s: %s\n' 'AUTH_TOKEN' "$_masked"
    printf '%-18s: %s\n' 'ANTHROPIC_API_KEY' '<unset>'
    printf '%-18s: %s\n' 'Fable' "$cfg_fable"
    printf '%-18s: %s\n' 'Opus' "$cfg_opus"
    printf '%-18s: %s\n' 'Sonnet' "$cfg_sonnet"
    printf '%-18s: %s\n' 'Haiku' "$cfg_haiku"
    printf '%-18s: %s\n' 'Subagent' "$cfg_subagent"
    printf '%-18s: %s\n' 'Discovery' "$discover"
    printf '%-18s: %s\n' 'ClaudeArgs' "$*"
    if switch_enabled; then
        printf '%-18s: %s\n' 'SwitchCurrently' 'enabled'
    else
        printf '%-18s: %s\n' 'SwitchCurrently' 'disabled'
    fi
    exit 0
fi

# ─── Launch ──────────────────────────────────────────────────────────────────
if ! _api_key=$(read_key); then
    printf '\n'
    warn 'No OpenRouter API key stored yet for this profile.'
    printf 'Store it once (file mode 0600):\n'
    printf '    claude-or-key --set-key\n\n'
    exit 1
fi

umask 077
mkdir -p "$PROFILE_ROOT"
chmod 700 "$PROFILE_ROOT" 2> /dev/null || :

# Skip the theme/login wizard in the isolated profile. Only touch the file when
# the flag is actually missing, so Claude Code keeps ownership of its own state.
_state=$PROFILE_ROOT/.claude.json
if [ ! -f "$_state" ]; then
    printf '%s\n' '{"hasCompletedOnboarding":true,"theme":"dark"}' > "$_state"
    chmod 600 "$_state"
elif command -v jq > /dev/null 2>&1 &&
    ! jq -e 'has("hasCompletedOnboarding")' "$_state" > /dev/null 2>&1; then
    _tmp=$_state.tmp.$$
    if jq '. + {hasCompletedOnboarding: true, theme: (.theme // "dark")}' \
        "$_state" > "$_tmp" 2> /dev/null; then
        chmod 600 "$_tmp"
        mv -f "$_tmp" "$_state"
    else
        rm -f "$_tmp"
    fi
fi

CLAUDE_CONFIG_DIR=$PROFILE_ROOT
ANTHROPIC_BASE_URL=$BASE_URL
ANTHROPIC_AUTH_TOKEN=$_api_key
ANTHROPIC_DEFAULT_FABLE_MODEL=$cfg_fable
ANTHROPIC_DEFAULT_OPUS_MODEL=$cfg_opus
ANTHROPIC_DEFAULT_SONNET_MODEL=$cfg_sonnet
ANTHROPIC_DEFAULT_HAIKU_MODEL=$cfg_haiku
CLAUDE_CODE_SUBAGENT_MODEL=$cfg_subagent
export CLAUDE_CONFIG_DIR ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN
export ANTHROPIC_DEFAULT_FABLE_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL
export ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL
export CLAUDE_CODE_SUBAGENT_MODEL
# Must be absent, not empty: Claude Code prefers an API key over the gateway
# token when both are set.
unset ANTHROPIC_API_KEY

if [ "$discover" -eq 1 ]; then
    CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
    export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY
else
    # The global switch may have exported 0; a one-shot without -Discover must
    # leave the picker off.
    unset CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY
fi

_claude=$(command -v claude 2> /dev/null) || {
    err 'claude not found on PATH.'
    err 'Install Claude Code first: https://claude.ai/install.sh'
    exit 127
}
case $_claude in
    /*) ;;
    *) die 'claude resolved to a shell function or builtin; run this from a fresh shell' ;;
esac

exec "$_claude" "$@"
