{{- /* The zjstatus status-bar pane: one line — mode badge, tabs, host, session,
     clock. Every layout includes this via `template "zjstatus"`, so the bar
     cannot drift between layouts and a session started from the sessionizer
     looks identical to the default one.

     The badge names the mode and nothing more; `dotfiles help` is where the
     bindings are looked up, so the bar does not spend a third of the line
     repeating them. */ -}}
{{- $p := .theme.palette -}}
{{- $u := .theme.ui -}}
        pane size=1 borderless=true {
            plugin location="file:{{ .chezmoi.homeDir }}/.local/share/zellij/plugins/zjstatus.wasm" {
                format_left   "{mode}#[bg={{ $u.statusline_bg }}] {tabs}"
                format_right  "#[bg={{ $u.statusline_bg }},fg={{ $p.comment }}]{command_host}#[bg={{ $u.statusline_bg }},fg={{ $p.blue7 }}] | #[bg={{ $u.statusline_bg }},fg={{ $p.blue }}]{session} #[bg={{ $u.statusline_bg }},fg={{ $p.blue7 }}]| #[bg={{ $u.statusline_bg }},fg={{ $p.fg_dark }}]{datetime}"
                format_space  "#[bg={{ $u.statusline_bg }}]"
                format_hide_on_overlength "true"
                format_precedence "lrs"

                border_enabled  "false"

                mode_normal        "#[bg={{ $p.green }},fg={{ $p.bg }},bold] NORMAL "
                mode_locked        "#[bg={{ $p.comment }},fg={{ $p.bg }},bold] LOCKED "
                mode_pane          "#[bg={{ $p.blue }},fg={{ $p.bg }},bold] PANE "
                mode_tab           "#[bg={{ $p.cyan }},fg={{ $p.bg }},bold] TAB "
                mode_scroll        "#[bg={{ $p.yellow }},fg={{ $p.bg }},bold] SCROLL "
                mode_enter_search  "#[bg={{ $p.yellow }},fg={{ $p.bg }},bold] SEARCH "
                mode_search        "#[bg={{ $p.yellow }},fg={{ $p.bg }},bold] SEARCH "
                mode_resize        "#[bg={{ $p.magenta }},fg={{ $p.bg }},bold] RESIZE "
                mode_move          "#[bg={{ $p.magenta }},fg={{ $p.bg }},bold] MOVE "
                mode_session       "#[bg={{ $p.purple }},fg={{ $p.bg }},bold] SESSION "
                mode_tmux          "#[bg={{ $p.orange }},fg={{ $p.bg }},bold] TMUX "
                mode_rename_tab    "#[bg={{ $p.cyan }},fg={{ $p.bg }},bold] RENAME "
                mode_rename_pane   "#[bg={{ $p.blue }},fg={{ $p.bg }},bold] RENAME "
                mode_default_to_mode "normal"

                tab_normal         "#[bg={{ $u.statusline_bg }},fg={{ $p.comment }}] {index}·{name} "
                tab_active         "#[bg={{ $p.bg_highlight }},fg={{ $p.blue }},bold] {index}·{name} "
                tab_sync_indicator " ⟳"
                tab_fullscreen_indicator " □"
                tab_floating_indicator " ⬚"

                command_host_command      "hostname -s"
                command_host_format       " {stdout}"
                command_host_interval     "0"
                command_host_rendermode   "static"

                datetime          "#[fg={{ $p.fg_dark }}]{format} "
                datetime_format   "%H:%M"
                datetime_timezone "Local"
            }
        }
