# ~/.profile — POSIX login shells (sh, dash, ksh) and bash login shells.
#
# The bash-specific counterpart is ~/.bash_profile, which sources this file and
# then ~/.bashrc. Keeping the environment here means a login as `sh` still gets
# PATH, XDG and EDITOR right.

[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/shell/env.sh" ] &&
    . "${XDG_CONFIG_HOME:-$HOME/.config}/shell/env.sh"
