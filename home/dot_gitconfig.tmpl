# Managed by chezmoi - https://www.chezmoi.io/
{{- /* Template variables are filled from ~/.config/chezmoi/chezmoi.toml */ -}}

[user]
    name = {{ .name | quote }}
    email = {{ .email | quote }}

[core]
{{- if .editor }}
    editor = {{ .editor }}
{{- else }}
    editor = code --wait
{{- end }}
    autocrlf = input
    safecrlf = warn
{{- if lookPath "delta" }}
    pager = delta
{{- end }}

[init]
    defaultBranch = main

{{- if .gpgSign }}
[commit]
    gpgsign = true
    
[gpg]
    program = gpg
{{- else }}
# Disable GPG signing by default to avoid authentication issues
# Uncomment and configure if you want to enable commit signing
# [commit]
#     gpgsign = true
# [gpg]
#     program = gpg
{{- end }}

[alias]
    st = status
    co = checkout
    ci = commit
    br = branch
    lg = log --oneline --graph --decorate
    lga = log --oneline --graph --decorate --all
    unstage = reset HEAD --
    last = log -1 HEAD
    amend = commit --amend --no-edit
    undo = reset --soft HEAD~1

[pull]
    rebase = true

[push]
    default = simple
    followTags = true

[fetch]
    prune = true

[rebase]
    autoStash = true

[diff]
{{- if lookPath "delta" }}
    colorMoved = default
{{- end }}

{{- if lookPath "delta" }}
[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    light = false
    side-by-side = true
{{- end }}

[merge]
    conflictstyle = diff3

[color]
    ui = auto

[help]
    autocorrect = 1
